# Application
APP_NAME=image-diff-backend
APP_ENV=dev
APP_PORT=8000

# Logger - keep "console" for development. The optional Winston transport
# was removed from this slim build.
LOGGER_TYPE=console
LOGGER_LEVEL=info

# Body parser limit for the multipart upload (must fit two images).
BODY_SIZE=60mb

# Per-file image upload limit (bytes). 30 MB is plenty for 4K screenshots.
MAX_IMAGE_BYTES=31457280

# CORS - comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173

# Swagger UI
SWAGGER_TITLE=Image Diff API
SWAGGER_DESCRIPTION=Server-side image diff endpoint backing the React UI.
SWAGGER_VERSION=0.1
SWAGGER_ENDPOINT=/api-docs
SWAGGER_FAVICON=/favicon.ico
